#include "morai_lateral_controller/mpc_controller.hpp"

#include <cmath>
#include <algorithm>
#include <iostream>

using std::placeholders::_1;

namespace morai_lateral_controller
{

MPCController::MPCController(const rclcpp::NodeOptions & options)
: Node("mpc_controller", options),
  vehicle_state_received_(false),
  osqp_work_(nullptr),
  osqp_settings_(nullptr),
  osqp_data_(nullptr),
  osqp_initialized_(false),
  previous_steering_(0.0)
{
  // Declare parameters
  this->declare_parameter("wheelbase", 1.04);  // [m]
  this->declare_parameter("control_rate", 20.0);  // [Hz]

  // MPC parameters
  this->declare_parameter("prediction_horizon", 15);
  this->declare_parameter("prediction_dt", 0.1);  // [s]

  // Cost weights
  this->declare_parameter("weight_cte", 10.0);
  this->declare_parameter("weight_heading", 1.0);
  this->declare_parameter("weight_steering", 0.1);
  this->declare_parameter("weight_steering_rate", 0.1);

  // Output limits
  this->declare_parameter("steering_max", 1.0);
  this->declare_parameter("steering_min", -1.0);

  // Get parameters
  wheelbase_ = this->get_parameter("wheelbase").as_double();
  control_rate_ = this->get_parameter("control_rate").as_double();

  prediction_horizon_ = this->get_parameter("prediction_horizon").as_int();
  prediction_dt_ = this->get_parameter("prediction_dt").as_double();

  weight_cte_ = this->get_parameter("weight_cte").as_double();
  weight_heading_ = this->get_parameter("weight_heading").as_double();
  weight_steering_ = this->get_parameter("weight_steering").as_double();
  weight_steering_rate_ = this->get_parameter("weight_steering_rate").as_double();

  steering_max_ = this->get_parameter("steering_max").as_double();
  steering_min_ = this->get_parameter("steering_min").as_double();

  // Initialize matrices
  A_cont_.resize(4, 0.0);  // 2x2
  B_cont_.resize(2, 0.0);  // 2x1
  A_d_.resize(4, 0.0);
  B_d_.resize(2, 0.0);

  // Setup MPC
  if (!setup_mpc()) {
    RCLCPP_ERROR(this->get_logger(), "Failed to setup MPC solver");
    return;
  }

  // Publishers
  lateral_cmd_pub_ = this->create_publisher<morai_msgs::msg::LateralControl>(
    "/lateral_cmd", 10);

  // Subscribers
  vehicle_state_sub_ = this->create_subscription<morai_msgs::msg::VehicleState>(
    "/vehicle_state", 10, std::bind(&MPCController::vehicle_state_callback, this, _1));

  // Control timer
  control_timer_ = this->create_wall_timer(
    std::chrono::duration<double>(1.0 / control_rate_),
    std::bind(&MPCController::compute_control, this)
  );

  RCLCPP_INFO(this->get_logger(),
    "MPC Lateral Controller initialized (N=%d, dt=%.2f s, wheelbase=%.2f m)",
    prediction_horizon_, prediction_dt_, wheelbase_);
}

MPCController::~MPCController()
{
  if (osqp_work_) {
    osqp_cleanup(osqp_work_);
  }
  if (osqp_settings_) {
    delete osqp_settings_;
  }
  if (osqp_data_) {
    if (osqp_data_->P) {
      delete osqp_data_->P;
    }
    if (osqp_data_->A) {
      delete osqp_data_->A;
    }
    delete osqp_data_;
  }
}

void MPCController::vehicle_state_callback(
  const morai_msgs::msg::VehicleState::SharedPtr msg)
{
  current_vehicle_state_ = msg;
  vehicle_state_received_ = true;
}

void MPCController::construct_state_space_matrices(double velocity, double dt)
{
  // Linearized bicycle model for path tracking
  // State: [cte, heading_error]
  // Input: [steering_angle]
  //
  // Continuous time model:
  // d(cte)/dt = velocity * sin(heading_error) ≈ velocity * heading_error
  // d(heading_error)/dt = (velocity / wheelbase) * steering_angle
  //
  // A = [0,  velocity]
  //     [0,     0    ]
  //
  // B = [       0        ]
  //     [velocity/wheelbase]

  // Continuous time A matrix (2x2)
  A_cont_[0] = 0.0;
  A_cont_[1] = velocity;
  A_cont_[2] = 0.0;
  A_cont_[3] = 0.0;

  // Continuous time B matrix (2x1)
  B_cont_[0] = 0.0;
  B_cont_[1] = velocity / wheelbase_;

  // Discretize using forward Euler: x_{k+1} = (I + A*dt)*x_k + B*dt*u_k
  // A_d = I + A*dt
  A_d_[0] = 1.0 + A_cont_[0] * dt;
  A_d_[1] = A_cont_[1] * dt;
  A_d_[2] = A_cont_[2] * dt;
  A_d_[3] = 1.0 + A_cont_[3] * dt;

  // B_d = B*dt
  B_d_[0] = B_cont_[0] * dt;
  B_d_[1] = B_cont_[1] * dt;
}

bool MPCController::setup_mpc()
{
  const int N = prediction_horizon_;
  const int nx = 2;  // Number of states: [cte, heading_error]
  const int nu = 1;  // Number of inputs: [steering_angle]

  // Decision variables: [u_0, u_1, ..., u_{N-1}] (only control inputs)
  const int n_vars = N * nu;

  // Number of constraints:
  // - State dynamics: 2*N constraints (x_{k+1} = A*x_k + B*u_k)
  // - Input bounds: N constraints
  const int n_constraints = nx * N + N;

  // Allocate OSQP structures
  osqp_data_ = new OSQPData;
  osqp_settings_ = new OSQPSettings;

  // Will be constructed dynamically in solve_mpc
  osqp_initialized_ = true;

  return true;
}

void MPCController::construct_qp_matrices()
{
  const int N = prediction_horizon_;
  const int nu = 1;
  const int nx = 2;
  const int n_vars = N * nu;

  // Hessian matrix P (n_vars x n_vars)
  // Cost: Σ_{k=0}^{N-1} (w_u * u_k^2 + w_du * (u_k - u_{k-1})^2)
  //     + Σ_{k=1}^{N} (w_cte * cte_k^2 + w_he * he_k^2)
  //
  // Since states are determined by inputs and initial state,
  // we need to express everything in terms of u
  //
  // Simplified: Just penalize control inputs and rates
  P_data_.clear();
  P_row_idx_.clear();
  P_col_ptr_.clear();

  // For simplicity, use diagonal P matrix
  // P(i,i) = weight_steering + 2*weight_steering_rate (for middle elements)
  P_col_ptr_.push_back(0);
  for (int i = 0; i < N; ++i) {
    double val = weight_steering_;
    if (i > 0) val += weight_steering_rate_;
    if (i < N - 1) val += weight_steering_rate_;

    P_data_.push_back(val);
    P_row_idx_.push_back(i);
    P_col_ptr_.push_back(P_data_.size());
  }

  // Gradient vector q (will be updated in solve_mpc based on current state)
  q_data_.resize(n_vars, 0.0);
}

bool MPCController::solve_mpc(
  double cte,
  double heading_error,
  double velocity,
  double & steering_output)
{
  const int N = prediction_horizon_;
  const int nu = 1;
  const int nx = 2;
  const int n_vars = N * nu;

  // Update state space matrices based on current velocity
  construct_state_space_matrices(velocity, prediction_dt_);

  // Construct QP matrices
  construct_qp_matrices();

  // Constraint matrix A and bounds l, u
  // Constraints: state dynamics and input bounds
  A_data_.clear();
  A_row_idx_.clear();
  A_col_ptr_.clear();
  l_data_.clear();
  u_data_.clear();

  // Initial state
  std::vector<double> x_current = {cte, heading_error};

  // Build constraint matrix
  // For each time step k = 0, ..., N-1:
  //   x_{k+1} = A_d * x_k + B_d * u_k
  //   => -B_d * u_k + x_{k+1} = A_d * x_k
  //   => -B_d * u_k <= -A_d * x_k (equality)
  //
  // Also add input bounds: u_min <= u_k <= u_max

  int constraint_idx = 0;

  // State dynamics constraints (2*N equations)
  std::vector<double> x_pred = x_current;

  for (int k = 0; k < N; ++k) {
    // Predict next state: x_{k+1} = A_d * x_k + B_d * u_k
    // Constraint: -B_d * u_k = -A_d * x_k (we'll handle as bounds)

    // For each state dimension
    for (int i = 0; i < nx; ++i) {
      // -B_d[i] * u_k
      double b_val = -B_d_[i];
      if (std::abs(b_val) > 1e-9) {
        A_data_.push_back(b_val);
        A_row_idx_.push_back(constraint_idx);
      }

      // RHS: -A_d * x_pred
      double rhs = -(A_d_[i * nx + 0] * x_pred[0] + A_d_[i * nx + 1] * x_pred[1]);
      l_data_.push_back(rhs);
      u_data_.push_back(rhs);

      constraint_idx++;
    }

    // Update x_pred for next iteration (using zero input as placeholder)
    double next_cte = A_d_[0] * x_pred[0] + A_d_[1] * x_pred[1];
    double next_he = A_d_[2] * x_pred[0] + A_d_[3] * x_pred[1];
    x_pred[0] = next_cte;
    x_pred[1] = next_he;
  }

  // Input bound constraints (N constraints)
  for (int k = 0; k < N; ++k) {
    A_data_.push_back(1.0);
    A_row_idx_.push_back(constraint_idx);

    l_data_.push_back(steering_min_);
    u_data_.push_back(steering_max_);

    constraint_idx++;
  }

  // Build column pointers for CSC format
  A_col_ptr_.clear();
  A_col_ptr_.push_back(0);
  for (int k = 0; k < N; ++k) {
    // Count non-zeros in column k
    int nnz = 0;
    for (size_t i = 0; i < A_row_idx_.size(); ++i) {
      if (A_row_idx_[i] >= k * nx && A_row_idx_[i] < (k + 1) * nx + 1) {
        nnz++;
      }
    }
    A_col_ptr_.push_back(A_col_ptr_.back() + nnz);
  }

  // Setup OSQP problem
  if (osqp_work_) {
    osqp_cleanup(osqp_work_);
    osqp_work_ = nullptr;
  }

  c_int n = n_vars;
  c_int m = l_data_.size();

  // Setup data
  OSQPData* data = new OSQPData;
  data->n = n;
  data->m = m;

  // P matrix (Hessian) - CSC format
  data->P = csc_matrix(n, n, P_data_.size(),
                       P_data_.data(),
                       P_row_idx_.data(),
                       P_col_ptr_.data());

  // q vector (gradient)
  data->q = q_data_.data();

  // A matrix (constraints) - CSC format
  data->A = csc_matrix(m, n, A_data_.size(),
                       A_data_.data(),
                       A_row_idx_.data(),
                       A_col_ptr_.data());

  // Bounds
  data->l = l_data_.data();
  data->u = u_data_.data();

  // Settings
  osqp_set_default_settings(osqp_settings_);
  osqp_settings_->verbose = 0;  // Silent
  osqp_settings_->warm_start = 1;
  osqp_settings_->max_iter = 4000;

  // Setup workspace
  c_int exitflag = osqp_setup(&osqp_work_, data, osqp_settings_);

  if (exitflag != 0) {
    RCLCPP_ERROR(this->get_logger(), "OSQP setup failed with exit flag %d", exitflag);
    delete data->P;
    delete data->A;
    delete data;
    return false;
  }

  // Solve
  osqp_solve(osqp_work_);

  if (osqp_work_->info->status_val != OSQP_SOLVED &&
      osqp_work_->info->status_val != OSQP_SOLVED_INACCURATE) {
    RCLCPP_WARN(this->get_logger(), "OSQP failed to find solution");
    delete data->P;
    delete data->A;
    delete data;
    return false;
  }

  // Extract first control input
  steering_output = osqp_work_->solution->x[0];

  // Cleanup
  delete data->P;
  delete data->A;
  delete data;

  return true;
}

void MPCController::compute_control()
{
  if (!vehicle_state_received_ || !current_vehicle_state_) {
    return;
  }

  // Get current state
  double cte = current_vehicle_state_->cross_track_error;
  double heading_error = current_vehicle_state_->heading_error;
  double velocity = std::max(0.1, current_vehicle_state_->velocity);  // Avoid division by zero

  // Solve MPC
  double steering_angle = 0.0;
  if (!solve_mpc(cte, heading_error, velocity, steering_angle)) {
    // Fallback: use previous steering
    steering_angle = previous_steering_;
    RCLCPP_WARN_THROTTLE(this->get_logger(), *this->get_clock(), 1000,
      "MPC solve failed, using previous steering");
  }

  // MORAI simulator inverts steering
  steering_angle = -steering_angle;

  // Clamp steering angle
  steering_angle = std::max(steering_min_, std::min(steering_max_, steering_angle));

  // Update previous steering
  previous_steering_ = steering_angle;

  // Prepare lateral control message
  auto control_msg = morai_msgs::msg::LateralControl();
  control_msg.header.stamp = this->now();
  control_msg.header.frame_id = "base_link";

  control_msg.steering_angle = steering_angle;
  control_msg.steering_angle_velocity = 0.0;

  // Debug information
  control_msg.curvature = 0.0;
  control_msg.lateral_error = cte;

  // Publish
  lateral_cmd_pub_->publish(control_msg);

  // Log
  RCLCPP_DEBUG(this->get_logger(),
    "MPC: CTE=%.3f, HE=%.3f rad, V=%.2f m/s, Steering=%.3f",
    cte, heading_error, velocity, steering_angle);
}

}  // namespace morai_lateral_controller
